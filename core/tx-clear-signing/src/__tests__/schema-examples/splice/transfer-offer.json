{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "5838793a7f11fbc16159065094823fb662120184ede48922dff092958dae6857",
            "moduleName": "Splice.Wallet.TransferOffer",
            "entityName": "TransferOffer"
        }
    },
    "metadata": {
        "version": "1.0.0",
        "publisher": "<splice publisher>",
        "name": "Wallet transfer offer",
        "enums": {
            "unit": {
                "USDUnit": "USD",
                "AmuletUnit": "Amulet",
                "ExtUnit": "other unit"
            }
        }
    },
    "display": {
        "create": {
            "intent": "Offer a transfer",
            "interpolatedIntent": "Offer {amount.amount} {amount.unit} to {receiver}: {description}",
            "fields": [
                {
                    "path": "amount.amount",
                    "label": "Amount",
                    "format": "number"
                },
                {
                    "path": "amount.unit",
                    "label": "Unit",
                    "format": "enum",
                    "params": {
                        "$ref": "$.metadata.enums.unit"
                    }
                },
                {
                    "path": "sender",
                    "label": "From",
                    "format": "party"
                },
                {
                    "path": "receiver",
                    "label": "To",
                    "format": "party"
                },
                {
                    "path": "description",
                    "label": "Description",
                    "format": "string"
                },
                {
                    "path": "expiresAt",
                    "label": "Expires",
                    "format": "dateTime"
                },
                {
                    "path": "trackingId",
                    "label": "Tracking ID",
                    "format": "string"
                }
            ]
        },
        "exercises": {
            "TransferOffer_Accept": {
                "intent": "Accept a transfer offer",
                "interpolatedIntent": "Accept {@.contract.amount.amount} {@.contract.amount.unit} from {@.contract.sender}"
            }
        }
    },
    "signatures": []
}
