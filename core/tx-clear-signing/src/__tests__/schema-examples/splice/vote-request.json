{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "0ff9141699e5eb734de1e1a8d11f97233ffd3892d1108872600cb3019fd4a86e",
            "moduleName": "Splice.DsoRules",
            "entityName": "VoteRequest"
        }
    },
    "metadata": {
        "version": "1.3.0",
        "publisher": "<splice publisher>",
        "name": "DSO vote request",
        "enums": {
            "rewardVersion": {
                "RewardVersion_FeaturedAppMarkers": "Featured app markers",
                "RewardVersion_TrafficBasedAppRewards": "Traffic-based app rewards"
            }
        }
    },
    "display": {
        "create": {
            "intent": "Create a DSO vote request",
            "interpolatedIntent": "Vote by {requester} on {action}, open until {voteBefore}",
            "fields": [
                {
                    "path": "requester",
                    "label": "Requester",
                    "format": "string"
                },
                {
                    "path": "voteBefore",
                    "label": "Open until",
                    "format": "dateTime"
                },
                {
                    "path": "reason.body",
                    "label": "Reason",
                    "format": "string"
                },
                {
                    "path": "votes",
                    "label": "Votes",
                    "format": "raw"
                },
                {
                    "path": "action",
                    "label": "Votes on",
                    "cases": {
                        "ARC_DsoRules": {
                            "label": "the DSO rules",
                            "fields": [
                                {
                                    "path": "dsoAction",
                                    "label": "Action",
                                    "cases": {
                                        "SRARC_AddSv": {
                                            "label": "add an SV"
                                        },
                                        "SRARC_OffboardSv": {
                                            "label": "offboard an SV"
                                        },
                                        "SRARC_ConfirmSvOnboarding": {
                                            "label": "confirm an SV onboarding"
                                        },
                                        "SRARC_GrantFeaturedAppRight": {
                                            "label": "grant a featured app right"
                                        },
                                        "SRARC_RevokeFeaturedAppRight": {
                                            "label": "revoke a featured app right"
                                        },
                                        "SRARC_UpdateSvRewardWeight": {
                                            "label": "change an SV reward weight"
                                        },
                                        "SRARC_CreateExternalPartyAmuletRules": {
                                            "label": "create the amulet rules for external parties"
                                        },
                                        "SRARC_CreateTransferCommandCounter": {
                                            "label": "create a transfer command counter"
                                        },
                                        "SRARC_CreateUnallocatedUnclaimedActivityRecord": {
                                            "label": "create an unallocated unclaimed activity record"
                                        },
                                        "SRARC_CreateBootstrapExternalPartyConfigStateInstruction": {
                                            "label": "bootstrap the external party config state"
                                        },
                                        "SRARC_UpdateFeaturedAppRight": {
                                            "label": "update a featured app right"
                                        },
                                        "SRARC_CreateFeaturedAppConfigUpdateInstruction": {
                                            "label": "update featured app configurations"
                                        },
                                        "SRARC_SetConfig": {
                                            "label": "change the DSO rules configuration",
                                            "fields": [
                                                {
                                                    "path": "newConfig.maxTextLength",
                                                    "label": "New max text length",
                                                    "format": "number"
                                                },
                                                {
                                                    "path": "baseConfig",
                                                    "label": "Current configuration",
                                                    "cases": {
                                                        "Some": {
                                                            "label": "set",
                                                            "fields": [
                                                                {
                                                                    "path": "maxTextLength",
                                                                    "label": "Max text length",
                                                                    "format": "number"
                                                                }
                                                            ]
                                                        },
                                                        "None": {
                                                            "label": "not given"
                                                        }
                                                    }
                                                },
                                                {
                                                    "path": "newConfig.voteCooldownTime",
                                                    "label": "New vote cooldown",
                                                    "format": "duration",
                                                    "cases": {
                                                        "None": {
                                                            "label": "not set"
                                                        }
                                                    }
                                                },
                                                {
                                                    "path": "newConfig.svOperationsSwitchOverTimes[\"cip-0104\"]",
                                                    "label": "CIP-0104 switch-over",
                                                    "format": "dateTime",
                                                    "cases": {
                                                        "None": {
                                                            "label": "not set"
                                                        }
                                                    }
                                                },
                                                {
                                                    "path": "newConfig.decentralizedSynchronizer.synchronizers",
                                                    "label": "Synchronizers",
                                                    "format": "raw"
                                                }
                                            ]
                                        }
                                    }
                                }
                            ]
                        },
                        "ARC_AmuletRules": {
                            "label": "the amulet rules",
                            "fields": [
                                {
                                    "path": "amuletRulesAction",
                                    "label": "Action",
                                    "cases": {
                                        "CRARC_MiningRound_StartIssuing": {
                                            "label": "start issuing a mining round"
                                        },
                                        "CRARC_MiningRound_Archive": {
                                            "label": "archive a mining round"
                                        },
                                        "CRARC_RemoveFutureAmuletConfigSchedule": {
                                            "label": "remove a scheduled amulet configuration"
                                        },
                                        "CRARC_UpdateFutureAmuletConfigSchedule": {
                                            "label": "change a scheduled amulet configuration"
                                        },
                                        "CRARC_SetConfig": {
                                            "label": "change the amulet configuration"
                                        },
                                        "CRARC_StartProcessingRewardsV2": {
                                            "label": "start processing rewards"
                                        },
                                        "CRARC_AddFutureAmuletConfigSchedule": {
                                            "label": "schedule an amulet configuration",
                                            "fields": [
                                                {
                                                    "path": "newScheduleItem._1",
                                                    "label": "Schedule from",
                                                    "format": "dateTime"
                                                },
                                                {
                                                    "path": "newScheduleItem._2.decentralizedSynchronizer.fees.extraTrafficPrice",
                                                    "label": "Extra traffic price",
                                                    "format": "number"
                                                },
                                                {
                                                    "path": "newScheduleItem._2.decentralizedSynchronizer.fees.baseRateTrafficLimits.burstWindow",
                                                    "label": "Burst window",
                                                    "format": "duration"
                                                },
                                                {
                                                    "path": "newScheduleItem._2.decentralizedSynchronizer.requiredSynchronizers",
                                                    "label": "Required synchronizers",
                                                    "format": "raw"
                                                },
                                                {
                                                    "path": "newScheduleItem._2.transferConfig.transferFee.steps",
                                                    "label": "Transfer fee steps",
                                                    "format": "raw"
                                                },
                                                {
                                                    "path": "newScheduleItem._2.rewardConfig",
                                                    "label": "Reward configuration",
                                                    "cases": {
                                                        "Some": {
                                                            "label": "set",
                                                            "fields": [
                                                                {
                                                                    "path": "mintingVersion",
                                                                    "label": "Minting",
                                                                    "format": "enum",
                                                                    "params": {
                                                                        "$ref": "$.metadata.enums.rewardVersion"
                                                                    }
                                                                },
                                                                {
                                                                    "path": "dsoAppActivityWeight",
                                                                    "label": "DSO app activity weight",
                                                                    "format": "number",
                                                                    "cases": {
                                                                        "None": {
                                                                            "label": "not set"
                                                                        }
                                                                    }
                                                                }
                                                            ]
                                                        },
                                                        "None": {
                                                            "label": "default"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                }
                            ]
                        },
                        "ARC_AnsEntryContext": {
                            "label": "an ANS entry"
                        },
                        "ExtActionRequiringConformation": {
                            "label": "an extension action"
                        }
                    }
                },
                {
                    "path": "trackingCid",
                    "label": "Tracking",
                    "format": "contractId",
                    "cases": {
                        "None": {
                            "label": "none"
                        }
                    }
                }
            ]
        }
    },
    "signatures": []
}
