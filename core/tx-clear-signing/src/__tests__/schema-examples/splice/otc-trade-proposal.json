{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "d7d5a8b925f41ef51c5732005d0d69a33cc49b8ba232e7f2f93f2da260687432",
            "moduleName": "Splice.Testing.Apps.TradingApp",
            "entityName": "OTCTradeProposal"
        }
    },
    "metadata": {
        "version": "1.2.0",
        "publisher": "<splice publisher>",
        "name": "OTC trade proposal"
    },
    "display": {
        "create": {
            "intent": "Propose an OTC trade",
            "interpolatedIntent": "Trade {transferLegs[\"leg0\"].amount} {transferLegs[\"leg0\"].instrumentId.id} from {transferLegs[\"leg0\"].sender} to {transferLegs[\"leg0\"].receiver}, one of {transferLegs.length} legs",
            "fields": [
                {
                    "path": "transferLegs[\"leg0\"].amount",
                    "label": "Leg 0 amount",
                    "format": "number"
                },
                {
                    "path": "transferLegs[\"leg0\"].instrumentId.id",
                    "label": "Leg 0 instrument",
                    "format": "string"
                },
                {
                    "path": "transferLegs[\"leg0\"].sender",
                    "label": "Leg 0 sender",
                    "format": "party"
                },
                {
                    "path": "transferLegs[\"leg0\"].receiver",
                    "label": "Leg 0 receiver",
                    "format": "party"
                },
                {
                    "path": "transferLegs[\"leg0\"].meta.values[\"example.com/note\"]",
                    "label": "Leg 0 note",
                    "format": "string"
                },
                {
                    "path": "transferLegs.length",
                    "label": "Number of legs",
                    "format": "number"
                },
                {
                    "path": "transferLegs",
                    "label": "Legs",
                    "format": "raw"
                },
                {
                    "path": "venue",
                    "label": "Venue",
                    "format": "party"
                },
                {
                    "path": "approvers",
                    "label": "Approved by",
                    "format": "raw"
                }
            ]
        },
        "exercises": [
            {
                "choice": "OTCTradeProposal_Accept",
                "intent": "Approve an OTC trade",
                "interpolatedIntent": "Approve, as {approver}, a trade of {@.contract.transferLegs.length} legs at {@.contract.venue}",
                "fields": [
                    {
                        "path": "@.contract.transferLegs.length",
                        "label": "Number of legs",
                        "format": "number"
                    },
                    {
                        "path": "@.contract.venue",
                        "label": "Venue",
                        "format": "party"
                    },
                    {
                        "path": "approver",
                        "label": "Approver",
                        "format": "party"
                    }
                ]
            }
        ]
    },
    "signatures": []
}
