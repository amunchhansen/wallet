{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "c5203dee918350373a993328e345872113bd5f8c8f0f51967014d813e583ae66",
            "moduleName": "Splice.Amulet",
            "entityName": "FeaturedAppRight"
        }
    },
    "metadata": {
        "version": "1.3.0",
        "publisher": "<splice publisher>",
        "name": "Featured app right",
        "enums": {
            "appKind": {
                "FAK_Basic": "Basic app",
                "FAK_AssetMoving": "Asset mover",
                "FAK_Asset": "Asset"
            }
        }
    },
    "display": {
        "create": {
            "intent": "Grant a featured app right",
            "interpolatedIntent": "Featured app right for {provider}",
            "fields": [
                {
                    "path": "provider",
                    "label": "Provider",
                    "format": "party"
                },
                {
                    "path": "appKind",
                    "label": "Kind",
                    "format": "enum",
                    "params": {
                        "$ref": "$.metadata.enums.appKind"
                    },
                    "cases": {
                        "None": {
                            "label": "not set"
                        }
                    }
                },
                {
                    "path": "activityWeight",
                    "label": "Activity weight",
                    "format": "number",
                    "cases": {
                        "None": {
                            "label": "default"
                        }
                    }
                },
                {
                    "path": "opsParties",
                    "label": "Operational parties",
                    "cases": {
                        "None": {
                            "label": "none"
                        }
                    }
                },
                {
                    "path": "opsParties.length",
                    "label": "Number of operational parties",
                    "format": "number",
                    "cases": {
                        "None": {
                            "label": "none"
                        }
                    }
                }
            ]
        },
        "exercises": [
            {
                "choice": "FeaturedAppRight_CreateActivityMarker",
                "intent": "Record featured app activity",
                "interpolatedIntent": "Record activity of {@.contract.provider} for {beneficiaries.length} beneficiaries",
                "fields": [
                    {
                        "path": "@.contract.provider",
                        "label": "Provider",
                        "format": "party"
                    },
                    {
                        "path": "beneficiaries.length",
                        "label": "Number of beneficiaries",
                        "format": "number"
                    },
                    {
                        "path": "beneficiaries",
                        "label": "Beneficiaries",
                        "format": "raw"
                    },
                    {
                        "path": "weight",
                        "label": "Weight",
                        "format": "number",
                        "cases": {
                            "None": {
                                "label": "not given"
                            }
                        }
                    }
                ]
            }
        ]
    },
    "signatures": []
}
