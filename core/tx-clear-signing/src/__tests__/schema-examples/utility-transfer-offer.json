{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "661151768d69141dfd6b757bdc348012b2a64b2c956ad586782f97d07408f264",
            "moduleName": "Utility.Registry.App.V0.Model.Transfer",
            "entityName": "TransferOffer"
        }
    },
    "metadata": {
        "version": "1.5.0",
        "publisher": "<utility-registry publisher>",
        "name": "Utility registry transfer offer"
    },
    "display": {
        "create": {
            "intent": "Transfer offer",
            "interpolatedIntent": "Offer of {transfer.amount} {transfer.instrumentId.id} from {transfer.sender} to {transfer.receiver}, to be accepted before {transfer.executeBefore}",
            "fields": [
                {
                    "path": "transfer.amount",
                    "label": "Amount",
                    "format": "number"
                },
                {
                    "path": "transfer.instrumentId.id",
                    "label": "Instrument",
                    "format": "string"
                },
                {
                    "path": "transfer.sender",
                    "label": "From",
                    "format": "party"
                },
                {
                    "path": "transfer.receiver",
                    "label": "To",
                    "format": "party"
                },
                {
                    "path": "transfer.executeBefore",
                    "label": "Accept before",
                    "format": "dateTime"
                }
            ]
        },
        "exercises": [
            {
                "choice": "TransferInstruction_Accept",
                "interface": {
                    "moduleName": "Splice.Api.Token.TransferInstructionV1",
                    "entityName": "TransferInstruction"
                },
                "intent": "Accept transfer offer",
                "interpolatedIntent": "Accept {@.contract.transfer.amount} {@.contract.transfer.instrumentId.id} from {@.contract.transfer.sender} to {@.contract.transfer.receiver}, settled according to the transfer rule at {extraArgs.context.values[\"utility.digitalasset.com/transfer-rule\"].AV_ContractId}",
                "fields": [
                    {
                        "path": "@.contract.transfer.amount",
                        "label": "Amount",
                        "format": "number"
                    },
                    {
                        "path": "@.contract.transfer.instrumentId.id",
                        "label": "Instrument",
                        "format": "string"
                    },
                    {
                        "path": "@.contract.transfer.sender",
                        "label": "From",
                        "format": "party"
                    },
                    {
                        "path": "@.contract.transfer.receiver",
                        "label": "To",
                        "format": "party"
                    },
                    {
                        "path": "extraArgs.context.values[\"utility.digitalasset.com/transfer-rule\"].AV_ContractId",
                        "label": "Transfer rule",
                        "format": "contractId"
                    }
                ]
            },
            {
                "choice": "TransferInstruction_Reject",
                "interface": {
                    "moduleName": "Splice.Api.Token.TransferInstructionV1",
                    "entityName": "TransferInstruction"
                },
                "intent": "Reject transfer offer",
                "interpolatedIntent": "Reject {@.contract.transfer.amount} {@.contract.transfer.instrumentId.id} from {@.contract.transfer.sender}",
                "fields": [
                    {
                        "path": "@.contract.transfer.amount",
                        "label": "Amount",
                        "format": "number"
                    },
                    {
                        "path": "@.contract.transfer.instrumentId.id",
                        "label": "Instrument",
                        "format": "string"
                    },
                    {
                        "path": "@.contract.transfer.sender",
                        "label": "From",
                        "format": "party"
                    }
                ]
            }
        ]
    },
    "signatures": []
}
