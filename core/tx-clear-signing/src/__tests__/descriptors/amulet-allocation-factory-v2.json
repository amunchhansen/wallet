{
    "$schema": "../canton-clear-signing-v1.schema.json",
    "context": {
        "template": {
            "packageId": "fb10433a48c24f30076a7aee03a3e314b7ab02fe9a22e2069e3af92d2b6ac88a",
            "moduleName": "Splice.ExternalPartyAmuletRules",
            "entityName": "ExternalPartyAmuletRules"
        }
    },
    "metadata": {
        "version": "1.0.0",
        "publisher": "<splice publisher>",
        "name": "Amulet rules for external parties",
        "enums": {
            "transferSide": {
                "SenderSide": "send to",
                "ReceiverSide": "receive from"
            },
            "commitment": {
                "true": "Committed: cannot be withdrawn before the settlement deadline",
                "false": "Not committed: can be withdrawn at any time"
            }
        }
    },
    "display": {
        "creates": {
            "intent": "Amulet rules for external parties",
            "interpolatedIntent": "Amulet rules for external parties, administered by {dso}",
            "fields": [
                { "path": "dso", "label": "Administrator", "format": "party" }
            ]
        },
        "exercises": {
            "Splice.Api.Token.AllocationInstructionV2:AllocationFactory:AllocationFactory_Allocate": {
                "intent": "Allocate funds for a settlement",
                "interpolatedIntent": "Allocate funds at {@.contract.dso} for settlement {settlement.id} of {allocation.transferLegSides.length} transfer legs, authorized by {allocation.authorizer.owner} and settled by {settlement.executors.[]}. {allocation.committed}",
                "fields": [
                    {
                        "path": "settlement.id",
                        "label": "Settlement",
                        "format": "string"
                    },
                    {
                        "path": "allocation.transferLegSides.length",
                        "label": "Transfer legs",
                        "format": "number"
                    },
                    {
                        "path": "allocation.authorizer.owner",
                        "label": "Authorizer",
                        "format": "party"
                    },
                    {
                        "path": "settlement.executors.[]",
                        "label": "Executors",
                        "format": "party"
                    },
                    {
                        "path": "allocation.transferLegSides.[].transferLegId",
                        "label": "Leg IDs",
                        "format": "string"
                    },
                    {
                        "path": "allocation.transferLegSides.[].side",
                        "label": "Leg directions",
                        "format": "enum",
                        "params": { "$ref": "$.metadata.enums.transferSide" }
                    },
                    {
                        "path": "allocation.transferLegSides.[].otherside.owner",
                        "label": "Leg counterparties",
                        "format": "party"
                    },
                    {
                        "path": "allocation.transferLegSides.[].amount",
                        "label": "Leg amounts",
                        "format": "number"
                    },
                    {
                        "path": "allocation.transferLegSides.[].instrumentId",
                        "label": "Leg instruments",
                        "format": "string"
                    },
                    {
                        "path": "allocation.committed",
                        "label": "Commitment",
                        "format": "enum",
                        "params": { "$ref": "$.metadata.enums.commitment" }
                    },
                    {
                        "path": "allocation.settlementDeadline",
                        "label": "Settlement deadline",
                        "format": "dateTime"
                    }
                ]
            }
        }
