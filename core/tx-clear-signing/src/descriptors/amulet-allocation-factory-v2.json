{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "fb10433a48c24f30076a7aee03a3e314b7ab02fe9a22e2069e3af92d2b6ac88a",
            "moduleName": "Splice.ExternalPartyAmuletRules",
            "entityName": "ExternalPartyAmuletRules"
        }
    },
    "metadata": {
        "version": "2.1.0",
        "publisher": "<splice publisher>",
        "name": "Amulet rules for external parties",
        "enums": {
            "commitment": {
                "true": "Committed: cannot be withdrawn before the settlement deadline",
                "false": "Not committed: can be withdrawn at any time"
            }
        }
    },
    "display": {
        "create": {
            "intent": "Amulet rules for external parties",
            "interpolatedIntent": "Amulet rules for external parties, administered by {dso}",
            "fields": [
                {
                    "path": "dso",
                    "label": "Administrator",
                    "format": "party"
                }
            ]
        },
        "exercises": {
            "TransferFactory_Transfer": {
                "intent": "Request a transfer",
                "interpolatedIntent": "Request a transfer of {transfer.amount} {transfer.instrumentId.id}. What the receiver does with it depends on the transfer's metadata",
                "fields": [
                    {
                        "path": "transfer.amount",
                        "label": "Requested amount",
                        "format": "number"
                    },
                    {
                        "path": "transfer.instrumentId.id",
                        "label": "Instrument",
                        "format": "string"
                    },
                    {
                        "path": "transfer.sender",
                        "label": "From",
                        "format": "party"
                    },
                    {
                        "path": "transfer.receiver",
                        "label": "To",
                        "format": "party"
                    },
                    {
                        "path": "transfer.sender.owner",
                        "label": "From account owner",
                        "format": "party"
                    },
                    {
                        "path": "transfer.receiver.owner",
                        "label": "To account owner",
                        "format": "party"
                    },
                    {
                        "path": "transfer.meta.values",
                        "label": "Metadata, which the receiver may act on",
                        "format": "raw"
                    },
                    {
                        "path": "transfer.executeBefore",
                        "label": "Execute before",
                        "format": "dateTime"
                    }
                ]
            },
            "AllocationFactory_Allocate": {
                "intent": "Allocate funds for a settlement",
                "interpolatedIntent": "Allocate funds at {@.contract.dso} for settlement {settlement.id} of {allocation.transferLegSides.length} transfer legs, authorized by {allocation.authorizer.owner}. {allocation.committed}",
                "fields": [
                    {
                        "path": "settlement.id",
                        "label": "Settlement",
                        "format": "string"
                    },
                    {
                        "path": "allocation.transferLegSides.length",
                        "label": "Number of legs",
                        "format": "number"
                    },
                    {
                        "path": "allocation.authorizer.owner",
                        "label": "Authorizer",
                        "format": "party"
                    },
                    {
                        "path": "settlement.executors",
                        "label": "Executors",
                        "format": "raw"
                    },
                    {
                        "path": "allocation.transferLegSides",
                        "label": "Legs",
                        "format": "raw"
                    },
                    {
                        "path": "allocation.committed",
                        "label": "Commitment",
                        "format": "enum",
                        "params": {
                            "$ref": "$.metadata.enums.commitment"
                        }
                    },
                    {
                        "path": "allocation.settlementDeadline",
                        "label": "Settlement deadline",
                        "format": "dateTime"
                    }
                ]
            }
        }
    },
    "signatures": []
}
