{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "de2cc2f90eb523414ff54e899951dadd8789a4c07e0f71f6d6c9eaf57d412a54",
            "moduleName": "Canton.Internal.Ping",
            "entityName": "Ping"
        }
    },
    "metadata": {
        "version": "1.0.0",
        "publisher": "Blockdaemon",
        "name": "Canton ping"
    },
    "display": {
        "create": {
            "intent": "Ping",
            "interpolatedIntent": "Ping {id} from {initiator} to {responder}",
            "fields": [
                {
                    "path": "id",
                    "label": "Ping ID",
                    "format": "string"
                },
                {
                    "path": "initiator",
                    "label": "Initiator",
                    "format": "party"
                },
                {
                    "path": "responder",
                    "label": "Responder",
                    "format": "party"
                }
            ]
        },
        "exercises": {
            "Respond": {
                "intent": "Respond to ping",
                "interpolatedIntent": "Respond to ping {@.contract.id} from {@.contract.initiator}"
            },
            "AbortPing": {
                "intent": "Abort ping",
                "interpolatedIntent": "Abort ping {@.contract.id} from {@.contract.initiator}, as {anyone}",
                "fields": [
                    {
                        "path": "anyone",
                        "label": "Aborted by",
                        "format": "party"
                    }
                ]
            }
        }
    },
    "signatures": []
}
