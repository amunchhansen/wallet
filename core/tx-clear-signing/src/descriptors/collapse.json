{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "de2cc2f90eb523414ff54e899951dadd8789a4c07e0f71f6d6c9eaf57d412a54",
            "moduleName": "Canton.Internal.Bong",
            "entityName": "Collapse"
        }
    },
    "metadata": {
        "version": "1.1.0",
        "publisher": "Blockdaemon",
        "name": "Canton bong collapse (canton-builtin-admin-workflow-ping)"
    },
    "display": {
        "create": {
            "intent": "Collapse",
            "interpolatedIntent": "Collapse bong {id} from {initiator} at path {path}",
            "fields": [
                {
                    "path": "id",
                    "label": "Bong ID",
                    "format": "string"
                },
                {
                    "path": "initiator",
                    "label": "Initiator",
                    "format": "party"
                },
                {
                    "path": "validators",
                    "label": "Validators",
                    "format": "raw"
                },
                {
                    "path": "responders",
                    "label": "Responders",
                    "format": "raw"
                },
                {
                    "path": "path",
                    "label": "Path",
                    "format": "string"
                },
                {
                    "path": "timeout",
                    "label": "Timeout",
                    "format": "dateTime"
                }
            ]
        },
        "exercises": {
            "ProcessCollapse": {
                "intent": "Process collapse",
                "interpolatedIntent": "Process collapse {@.contract.id} path {@.contract.path} as {winner}",
                "fields": [
                    {
                        "path": "winner",
                        "label": "Winner",
                        "format": "party"
                    }
                ]
            },
            "AbortCollapse": {
                "intent": "Abort collapse",
                "interpolatedIntent": "Abort collapse {@.contract.id} as {anyone}",
                "fields": [
                    {
                        "path": "anyone",
                        "label": "Aborted by",
                        "format": "party"
                    }
                ]
            }
        }
    },
    "signatures": []
}
