{
    "$schema": "https://example.org/canton-clear-signing/v1/schema.json",
    "context": {
        "template": {
            "packageId": "de2cc2f90eb523414ff54e899951dadd8789a4c07e0f71f6d6c9eaf57d412a54",
            "moduleName": "Canton.Internal.Bong",
            "entityName": "BongProposal"
        }
    },
    "metadata": {
        "version": "1.0.0",
        "publisher": "Blockdaemon",
        "name": "Canton bong proposal"
    },
    "display": {
        "create": {
            "intent": "Bong proposal",
            "interpolatedIntent": "Propose bong {id} from {initiator} to {responders.[]} at level {maxLevel}, accepted by {candidates.[]}",
            "fields": [
                {
                    "path": "id",
                    "label": "Bong ID",
                    "format": "string"
                },
                {
                    "path": "initiator",
                    "label": "Initiator",
                    "format": "party"
                },
                {
                    "path": "candidates.[]",
                    "label": "Candidates",
                    "format": "party"
                },
                {
                    "path": "validators.[]",
                    "label": "Validators",
                    "format": "party"
                },
                {
                    "path": "responders.[]",
                    "label": "Responders",
                    "format": "party"
                },
                {
                    "path": "maxLevel",
                    "label": "Level",
                    "format": "number"
                },
                {
                    "path": "timeout",
                    "label": "Timeout",
                    "format": "dateTime"
                }
            ]
        },
        "exercises": {
            "Accept": {
                "intent": "Accept bong proposal",
                "interpolatedIntent": "Accept bong {@.contract.id} as {validator}",
                "fields": [
                    {
                        "path": "validator",
                        "label": "Validator",
                        "format": "party"
                    }
                ]
            },
            "AbortBongProposal": {
                "intent": "Abort bong proposal",
                "interpolatedIntent": "Abort bong proposal {@.contract.id} as {anyone}",
                "fields": [
                    {
                        "path": "anyone",
                        "label": "Aborted by",
                        "format": "party"
                    }
                ]
            }
        }
    },
    "signatures": []
}
